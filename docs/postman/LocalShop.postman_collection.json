{
  "info": {
    "name": "LocalShop",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5050/api" },
    { "key": "customerToken", "value": "" },
    { "key": "sellerToken", "value": "" },
    { "key": "otherSellerToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "01 Auth",
      "item": [
        {
          "name": "Register Customer",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Customer One\",\n  \"email\": \"customer1@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"CUSTOMER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register Seller",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Seller One\",\n  \"email\": \"seller1@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"SELLER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Register Another Seller (for Wrong Owner tests)",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Seller Two\",\n  \"email\": \"seller2@test.com\",\n  \"password\": \"password123\",\n  \"role\": \"SELLER\"\n}"
            },
            "url": "{{baseUrl}}/auth/register"
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"customer1@test.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "02 Products",
      "item": [
        {
          "name": "List",
          "request": { "method": "GET", "url": "{{baseUrl}}/products" }
        },
        {
          "name": "Search",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?search=honey" }
        },
        {
          "name": "Category Filter",
          "request": { "method": "GET", "url": "{{baseUrl}}/products?category=food" }
        },
        {
          "name": "Detail",
          "request": { "method": "GET", "url": "{{baseUrl}}/products/{{productId}}" }
        }
      ]
    },
    {
      "name": "03 Seller Products",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Honey\",\n  \"description\": \"Organic honey\",\n  \"price\": 50,\n  \"stock\": 10,\n  \"category\": \"food\"\n}"
            },
            "url": "{{baseUrl}}/products"
          }
        },
        {
          "name": "My Products",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": "{{baseUrl}}/seller/products"
          }
        },
        {
          "name": "Update",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 55\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Delete",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update - No Token (401)",
          "request": {
            "method": "PATCH",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 55\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update - Invalid Token (401)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer this.is.not.a.valid.jwt" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 55\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update - Wrong Role / Customer Token (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 55\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        },
        {
          "name": "Update - Wrong Owner / Other Seller (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherSellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"price\": 55\n}" },
            "url": "{{baseUrl}}/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "04 Cart",
      "item": [
        {
          "name": "Get",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/cart"
          }
        },
        {
          "name": "Add Item",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "url": "{{baseUrl}}/cart/items"
          }
        },
        {
          "name": "Update Quantity",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"quantity\": 3\n}" },
            "url": "{{baseUrl}}/cart/items/{{productId}}"
          }
        },
        {
          "name": "Remove Item",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/cart/items/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "05 Orders",
      "item": [
        {
          "name": "Create",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Customer Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/orders"
          }
        },
        {
          "name": "Order Detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{customerToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Order Detail - Wrong Owner (403)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": "{{baseUrl}}/orders/{{orderId}}"
          }
        },
        {
          "name": "Seller Orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{sellerToken}}" }],
            "url": "{{baseUrl}}/seller/orders"
          }
        },
        {
          "name": "Seller Update Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{sellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SHIPPED\"\n}" },
            "url": "{{baseUrl}}/seller/orders/{{orderId}}/status"
          }
        },
        {
          "name": "Seller Update Status - Wrong Owner / Other Seller (403)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{otherSellerToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"status\": \"SHIPPED\"\n}" },
            "url": "{{baseUrl}}/seller/orders/{{orderId}}/status"
          }
        }
      ]
    },
    {
      "name": "06 Payments",
      "item": [
        {
          "name": "Successful Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"cardNumber\": \"4242424242424242\",\n  \"cardHolder\": \"Customer One\",\n  \"expiry\": \"12/30\",\n  \"cvv\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/payments/pay"
          }
        },
        {
          "name": "Failed Payment",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{customerToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"cardNumber\": \"4000000000000002\",\n  \"cardHolder\": \"Customer One\",\n  \"expiry\": \"12/30\",\n  \"cvv\": \"123\"\n}"
            },
            "url": "{{baseUrl}}/payments/pay"
          }
        }
      ]
    }
  ]
}
